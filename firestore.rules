rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user is a member of a cookbook
    function isMember(cookbookId) {
      return exists(/databases/$(database)/documents/cookbookMembers/$(cookbookId)_$(request.auth.uid))
        || get(/databases/$(database)/documents/cookbooks/$(cookbookId)).data.ownerId == request.auth.uid;
    }

    // Cookbooks
    match /cookbooks/{cookbookId} {
      allow create: if isAuth();
      allow read: if isAuth() && (resource.data.ownerId == request.auth.uid
        || exists(/databases/$(database)/documents/cookbookMembers/$(cookbookId)/$(request.auth.uid)));
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Cookbook Members
    match /cookbookMembers/{memberId} {
      allow read: if isAuth() && isMember(resource.data.cookbookId);
      allow create: if isAuth();
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/cookbooks/$(resource.data.cookbookId)).data.ownerId == request.auth.uid
      );
      allow update: if false;
    }

    // Cookbook Recipes
    match /cookbookRecipes/{recipeId} {
      allow read: if isAuth() && isMember(resource.data.cookbookId);
      allow create: if isAuth()
        && request.resource.data.cookbookId is string
        && request.resource.data.type in ['meal', 'custom']
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.likes == [];
      allow delete: if isAuth() && resource.data.addedBy == request.auth.uid;
      allow update: if isAuth()
        && resource.data.addedBy == request.auth.uid
        && request.resource.data.likes == resource.data.likes;
    }

    // Users (read by cookbook feature)
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == userId;
    }
  }
}